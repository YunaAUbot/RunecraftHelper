<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <NoWarn>1701;1702;1591</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <PlatformTarget>x64</PlatformTarget>
    <GameHelperHostRoot Condition="'$(GameHelperHostRoot)' == ''">$(GAMEHELPER2_HOST_ROOT)</GameHelperHostRoot>
  </PropertyGroup>

  <Target Name="ValidateGameHelperHost" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(GameHelperHostRoot)' == ''" Text="Set GAMEHELPER2_HOST_ROOT or pass -p:GameHelperHostRoot=/path/to/GameHelper2." />
    <Error Condition="!Exists('$(GameHelperHostRoot)/GameHelper/GameHelper.csproj')" Text="GameHelper host project not found below '$(GameHelperHostRoot)'." />
  </Target>

  <ItemGroup>
    <ProjectReference Include="$(GameHelperHostRoot)/GameHelper/GameHelper.csproj">
      <Private>false</Private>
      <CopyLocalSatelliteAssemblies>false</CopyLocalSatelliteAssemblies>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="RunecraftHelper.Tests/**/*.cs" />
    <Content Include="expedition2_recipes.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="relic_mods_en.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="icons/**/*.png"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Localization/**/*.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>RunecraftHelper</AssemblyName>
    <RootNamespace>RunecraftHelper</RootNamespace>
    <!-- Keep auxiliary sources/resources and nested build artifacts out of the plugin. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);test/**;tools/**;**/obj/**;**/bin/**</DefaultItemExcludes>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <NoWarn>1701;1702;1591</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <PlatformTarget>x64</PlatformTarget>
    <GameHelperHostRoot Condition="'$(GameHelperHostRoot)' == ''">$(GAMEHELPER2_HOST_ROOT)</GameHelperHostRoot>
  </PropertyGroup>

  <Target Name="ValidateGameHelperHost" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(GameHelperHostRoot)' == ''" Text="Set GAMEHELPER2_HOST_ROOT or pass -p:GameHelperHostRoot=/path/to/GameHelper2." />
    <Error Condition="!Exists('$(GameHelperHostRoot)/GameHelper/GameHelper.csproj')" Text="GameHelper host project not found below '$(GameHelperHostRoot)'." />
  </Target>

  <ItemGroup>
    <ProjectReference Include="$(GameHelperHostRoot)/GameHelper/GameHelper.csproj">
      <Private>false</Private>
      <CopyLocalSatelliteAssemblies>false</CopyLocalSatelliteAssemblies>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="expedition2_recipes.json" Exclude="$(DefaultItemExcludes)"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="relic_mods_en.json" Exclude="$(DefaultItemExcludes)"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="icons/**/*.png" Exclude="$(DefaultItemExcludes)"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Localization/**/*.json" Exclude="$(DefaultItemExcludes)"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
  </ItemGroup>
</Project>
